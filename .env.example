# Application
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# Local Docker PostgreSQL. Docker Compose uses these values for the local database.
POSTGRES_USER=firebusters
POSTGRES_PASSWORD=firebusters_dev
POSTGRES_DB=firebusters

# Hosted backend: paste Supabase's Session pooler connection string and change
# postgresql:// to postgresql+asyncpg://. Keep ssl=require.
# Example:
# postgresql+asyncpg://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://firebusters:firebusters_dev@localhost:5434/firebusters

# Supabase > Project Settings > Data API / API Keys
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Backend and ingestion only. Never expose this value through VITE_* variables.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=firebusters-assets

# AI provider. Groq and OpenAI use the OpenAI-compatible adapter; Anthropic uses
# its native adapter. Switch with configuration rather than application changes.
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Cloudflare R2 (future large-asset storage; optional for the presentation MVP)
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=flamelens-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Local frontend
VITE_API_BASE_URL=http://localhost:8001/api/v1
